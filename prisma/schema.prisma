datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums & User Roles ───────────────────────────────────────────────────────

enum UserRole {
  PUBLIC_VISITOR
  APPLICANT
  LEARNER
  INSTRUCTOR
  DTA_ADMINISTRATOR
  DTA_MANAGEMENT
  CORPORATE_ADMINISTRATOR
  SUPER_ADMINISTRATOR
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum EnrollmentStatus {
  PENDING_PAYMENT
  PAYMENT_INITIATED
  PAYMENT_CONFIRMED
  ENROLLED
  SUSPENDED
  WITHDRAWN
  COMPLETED
}

enum PaymentProvider {
  PAYSTACK
  MANUAL_BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  INITIATED
  SUCCESSFUL
  FAILED
  EXPIRED
  PENDING_VERIFICATION
  REFUNDED
  CANCELLED
}

enum CertificateStatus {
  VALID
  REVOKED
  REPLACED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  ARCHIVED
}

// ─── Core User & Organization Models ──────────────────────────────────────────

model User {
  id                     String              @id @default(cuid())
  name                   String?
  email                  String              @unique
  passwordHash           String
  phone                  String?
  role                   UserRole            @default(LEARNER)
  country                String?
  state                  String?
  professionalBackground String?
  experienceLevel        String?             // BEGINNER | INTERMEDIATE | ADVANCED
  preferredFormat        String?             // SELF_PACED | INSTRUCTOR_LED | HYBRID
  prideAccepted          Boolean             @default(false)
  organizationId         String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  organization           Organization?       @relation(fields: [organizationId], references: [id])
  applications           Application[]
  enrollments            Enrollment[]
  submissions            Submission[]
  assessmentAttempts     AssessmentAttempt[]
  attendances            Attendance[]
  auditLogs              AuditLog[]
  cohortsTaught          Cohort[]            @relation("CohortInstructor")
  liveClassesTaught      LiveClass[]         @relation("LiveClassInstructor")
  certificates           CertificateRecord[]
}

model Organization {
  id           String       @id @default(cuid())
  name         String
  type         String       @default("CORPORATE") // CORPORATE | GOVERNMENT | NGO
  industry     String?
  contactEmail String
  contactPhone String?
  status       String       @default("ACTIVE")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  users        User[]
  cohorts      Cohort[]
  enrollments  Enrollment[]
}

model Lead {
  id                String     @id @default(cuid())
  name              String
  email             String
  phone             String?
  programmeInterest String
  source            String?    // Facebook, Instagram, X, TikTok, YouTube, WhatsApp, Referral, Direct
  campaign          String?
  status            LeadStatus @default(NEW)
  createdAt         DateTime   @default(now())
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  programmeId     String
  status          ApplicationStatus @default(SUBMITTED)
  backgroundNotes String?
  reviewNotes     String?
  reviewedBy      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  programme       Programme         @relation(fields: [programmeId], references: [id])
}

model Programme {
  id                   String              @id @default(cuid())
  title                String
  slug                 String              @unique
  school               String              @default("School of Generative Artificial Intelligence")
  description          String
  objectives           String[]
  durationWeeks        Int                 @default(8)
  deliveryMode         String              @default("ONLINE_LIVE")
  price                Decimal             @db.Decimal(12, 2)
  earlyBirdPrice       Decimal?            @db.Decimal(12, 2)
  isPublished          Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  cohorts              Cohort[]
  applications         Application[]
  modules              Module[]
  certificatesIssued   CertificateRecord[]
}

model Cohort {
  id             String              @id @default(cuid())
  programmeId    String?
  cohortCode     String?             @unique // e.g. GENAI-WP-001
  title          String
  startDate      DateTime
  endDate        DateTime
  capacity       Int                 @default(30)
  instructorId   String?
  organizationId String?
  status         String              @default("UPCOMING") // UPCOMING | ACTIVE | COMPLETED
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  programme      Programme?          @relation(fields: [programmeId], references: [id])
  instructor     User?               @relation("CohortInstructor", fields: [instructorId], references: [id])
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  enrollments    Enrollment[]
  liveClasses    LiveClass[]
  certificates   CertificateRecord[]
}

model Enrollment {
  id             String              @id @default(cuid())
  userId         String
  cohortId       String
  organizationId String?
  paymentPlan    String              // FULL_UPFRONT | INSTALLMENT
  totalAmount    Decimal             @db.Decimal(12, 2)
  amountPaid     Decimal             @default(0.00) @db.Decimal(12, 2)
  status         EnrollmentStatus    @default(PENDING_PAYMENT)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort         Cohort              @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  paymentRecords PaymentRecord[]
  certificate    CertificateRecord?

  @@unique([userId, cohortId]) // Prevents duplicate active enrolments per cohort
}

model PaymentRecord {
  id               String          @id @default(cuid())
  enrollmentId     String
  provider         PaymentProvider @default(PAYSTACK)
  providerRef      String?         @unique // Nullable for manual bank deposits
  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @default("NGN")
  status           PaymentStatus   @default(PENDING)
  paymentDate      DateTime        @default(now())
  verificationDate DateTime?
  verifiedBy       String?
  enrollment       Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model Track {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  modules     Module[]
}

model Module {
  id                String       @id @default(cuid())
  trackId           String?
  programmeId       String?
  title             String
  order             Int
  contentMarkdown   String
  githubStarterRepo String?
  youtubeId         String?      // 11-character YouTube video ID
  durationMinutes   Int?         // Lesson duration in minutes
  isFreePreview     Boolean      @default(false) // Public preview access flag
  track             Track?       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  programme         Programme?   @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  assignments       Assignment[]
  assessments       Assessment[]
}

model Assignment {
  id               String       @id @default(cuid())
  moduleId         String
  title            String
  instructions     String
  githubPRRequired Boolean      @default(false)
  dueDate          DateTime
  module           Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions      Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  userId       String
  githubPRUrl  String?
  status       String     @default("PENDING") // PENDING | APPROVED | REJECTED
  grade        String?
  feedback     String?
  submittedAt  DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LiveClass {
  id           String       @id @default(cuid())
  cohortId     String
  title        String
  scheduledAt  DateTime
  durationMins Int          @default(60)
  meetingUrl   String       // Zoom / Google Meet / Teams URL
  recordingUrl String?
  instructorId String
  createdAt    DateTime     @default(now())
  cohort       Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  instructor   User         @relation("LiveClassInstructor", fields: [instructorId], references: [id])
  attendances  Attendance[]
}

model Attendance {
  id          String    @id @default(cuid())
  liveClassId String
  userId      String
  status      String    @default("PRESENT") // PRESENT | ABSENT | EXCUSED
  joinedAt    DateTime?
  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assessment {
  id            String              @id @default(cuid())
  moduleId      String
  title         String
  description   String?
  passScore     Float               @default(70.0)
  timeLimitMins Int?
  maxAttempts   Int                 @default(3)
  questionsJson String              // Protected server-side questions JSON
  attempts      AssessmentAttempt[]
  module        Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model AssessmentAttempt {
  id           String     @id @default(cuid())
  assessmentId String
  userId       String
  score        Float
  passed       Boolean
  answersJson  String
  completedAt  DateTime   @default(now())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PracticalProject {
  id            String   @id @default(cuid())
  programmeId   String
  title         String
  instructions  String
  rubricJson    String?
  createdAt     DateTime @default(now())
}

// ─── Certificate Authority (Redesigned with Full Relations) ──────────────────

model CertificateRecord {
  id                     String            @id @default(cuid())
  certificateNumber      String            @unique // Format: DWSA-DTA-GENAI-YYYY-XXXXX (Dynamic year + sequential number)
  userId                 String
  programmeId            String
  cohortId               String?
  enrollmentId           String            @unique
  certificateType        String            // Professional Diploma | Executive Certificate | Competency Badge
  verificationCode       String            @unique
  verificationStatus     CertificateStatus @default(VALID)
  issueDate              DateTime          @default(now())
  completionDate         DateTime          @default(now())
  signatoryName          String            @default("Digital Technology Academy Senate")
  qrCodeUrl              String?

  // Snapshot fields preserved for immutable certificate audit integrity
  learnerNameSnapshot    String
  programmeTitleSnapshot String

  user                   User              @relation(fields: [userId], references: [id])
  programme              Programme         @relation(fields: [programmeId], references: [id])
  cohort                 Cohort?           @relation(fields: [cohortId], references: [id])
  enrollment             Enrollment        @relation(fields: [enrollmentId], references: [id])
}

// ─── Enterprise Intelligence & Audit Models ──────────────────────────────────

model CompetencyScore {
  id             String   @id @default(cuid())
  studentId      String
  competency     String
  score          Float
  level          String   // Proficient | Advanced | Expert
  assessedBy     String
  assessmentType String   // FacultyValidation | AutomatedRubric | PeerReview
  remarks        String?
  createdAt      DateTime @default(now())
}

model AchievementBadge {
  id          String   @id @default(cuid())
  studentId   String
  badge       String
  category    String   // Academic | DevOps | Engagement | Leadership | AI
  description String
  earnedAt    DateTime @default(now())
  verifiedBy  String?
}

model LearningMilestone {
  id          String    @id @default(cuid())
  studentId   String
  title       String
  description String
  status      String    @default("UPCOMING") // Completed | In Progress | Upcoming
  completedAt DateTime?
}

model DigitalTranscript {
  id                   String   @id @default(cuid())
  studentId            String   @unique
  programme            String
  overallProgress      Float
  gpaEquivalent        Float
  completionPercentage Float
  generatedAt          DateTime @default(now())
}

model EmploymentReadiness {
  id                 String   @id @default(cuid())
  studentId          String   @unique
  technicalScore     Float
  portfolioScore     Float
  githubScore        Float
  communicationScore Float
  overallReadiness   Float
  recommendation     String
}

model FacultyAssessment {
  id         String   @id @default(cuid())
  facultyId  String
  studentId  String
  module     String
  competency String
  score      Float
  feedback   String?
  createdAt  DateTime @default(now())
}

model InstitutionMetricSnapshot {
  id         String   @id @default(cuid())
  metric     String
  value      Float
  capturedAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // e.g. PAYMENT_VERIFICATION, CERTIFICATE_ISSUANCE, ROLE_CHANGE
  targetId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}
