datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  passwordHash  String
  phone         String?
  role          String       @default("STUDENT") // STUDENT | INSTRUCTOR | ADMIN
  prideAccepted Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  enrollments   Enrollment[]
  submissions   Submission[]
}

model Cohort {
  id          String       @id @default(cuid())
  title       String
  startDate   DateTime
  endDate     DateTime
  status      String       @default("UPCOMING") // UPCOMING | ACTIVE | COMPLETED
  enrollments Enrollment[]
}

model Enrollment {
  id             String          @id @default(cuid())
  userId         String
  cohortId       String
  paymentPlan    String          // FULL_UPFRONT | INSTALLMENT
  totalAmount    Float
  amountPaid     Float           @default(0)
  status         String          @default("PENDING") // PENDING | ACTIVE | SUSPENDED | GRADUATED
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort         Cohort          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  paymentRecords PaymentRecord[]
}

model PaymentRecord {
  id           String     @id @default(cuid())
  enrollmentId String
  paystackRef  String     @unique
  amount       Float
  paymentDate  DateTime   @default(now())
  channel      String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model Track {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  modules     Module[]
}

model Module {
  id                String       @id @default(cuid())
  trackId           String
  title             String
  order             Int
  contentMarkdown   String
  githubStarterRepo String?
  youtubeId         String?      // 11-character YouTube video ID
  durationMinutes   Int?         // Lesson duration in minutes
  isFreePreview     Boolean      @default(false) // Public preview access flag
  track             Track        @relation(fields: [trackId], references: [id], onDelete: Cascade)
  assignments       Assignment[]
}

model Assignment {
  id               String       @id @default(cuid())
  moduleId         String
  title            String
  instructions     String
  githubPRRequired Boolean      @default(false)
  dueDate          DateTime
  module           Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions      Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  userId       String
  githubPRUrl  String?
  status       String     @default("PENDING") // PENDING | APPROVED | REJECTED
  grade        String?
  feedback     String?
  submittedAt  DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── InstitutionOS v3.5 Enterprise Intelligence & Credential Models ─────────

model CompetencyScore {
  id             String   @id @default(cuid())
  studentId      String
  competency     String
  score          Float
  level          String   // Proficient | Advanced | Expert
  assessedBy     String
  assessmentType String   // FacultyValidation | AutomatedRubric | PeerReview
  remarks        String?
  createdAt      DateTime @default(now())
}

model AchievementBadge {
  id          String   @id @default(cuid())
  studentId   String
  badge       String
  category    String   // Academic | DevOps | Engagement | Leadership | AI
  description String
  earnedAt    DateTime @default(now())
  verifiedBy  String?
}

model LearningMilestone {
  id          String    @id @default(cuid())
  studentId   String
  title       String
  description String
  status      String    @default("UPCOMING") // Completed | In Progress | Upcoming
  completedAt DateTime?
}

model DigitalTranscript {
  id                   String   @id @default(cuid())
  studentId            String   @unique
  programme            String
  overallProgress      Float
  gpaEquivalent        Float
  completionPercentage Float
  generatedAt          DateTime @default(now())
}

model CertificateRecord {
  id                 String   @id @default(cuid())
  studentId          String
  certificateType    String   // Professional Diploma | Competency Certificate | Honor Badge
  verificationCode   String   @unique
  verificationStatus String   @default("VERIFIED") // VERIFIED | PENDING | REVOKED
  issuedAt           DateTime @default(now())
}

model EmploymentReadiness {
  id                 String   @id @default(cuid())
  studentId          String   @unique
  technicalScore     Float
  portfolioScore     Float
  githubScore        Float
  communicationScore Float
  overallReadiness   Float
  recommendation     String
}

model FacultyAssessment {
  id         String   @id @default(cuid())
  facultyId  String
  studentId  String
  module     String
  competency String
  score      Float
  feedback   String?
  createdAt  DateTime @default(now())
}

model InstitutionMetricSnapshot {
  id         String   @id @default(cuid())
  metric     String
  value      Float
  capturedAt DateTime @default(now())
}

